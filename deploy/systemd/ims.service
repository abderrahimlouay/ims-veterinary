# The application as a service on the production server (docs/deployment.md, ADR-150, ADR-151).
# Install as /etc/systemd/system/ims.service; the environment (accounts, backup folder) is in /etc/ims/ims.env,
# readable by root only (systemd reads it before dropping to the ims user). Migrations are not run here: a release
# runs the migrate mode first (README, Production release).
[Unit]
Description=IMS Vétérinaire application
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=ims
Group=ims
EnvironmentFile=/etc/ims/ims.env
WorkingDirectory=/opt/ims
ExecStart=/usr/bin/java -Xms512m -Xmx1536m -jar /opt/ims/ims.jar
# 143 = stopped by SIGTERM after the graceful shutdown (application-prod.yml).
SuccessExitStatus=143
TimeoutStopSec=60
Restart=on-failure
RestartSec=10

# Hardening: the application writes only its backups (IMS_BACKUP_DIR) and its private temporary files.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/ims/backups
UMask=0077

[Install]
WantedBy=multi-user.target
