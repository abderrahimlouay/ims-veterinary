# build output
backend/target/
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/

# secrets and local env
.env
.env.*
!.env.example

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store

# logs, coverage and test reports (any module)
*.log
coverage/
playwright-report/
test-results/

# database dumps and backups; SQL under backend/src (Flyway migrations, test fixtures) stays tracked
*.sql
!backend/src/**/*.sql
*.sql.gz
*.dump
backups/

# keys, certificates and keystores
*.pem
*.key
*.p12
*.pfx
*.jks
