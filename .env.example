# Copy to .env (git-ignored) and fill in. Names only: never commit values.
# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=
# JDBC URL, e.g. jdbc:mysql://<host>:3306/<database>
IMS_DB_URL=
IMS_DB_USERNAME=
IMS_DB_PASSWORD=
# First Administrator, used only while the users table is empty (ADR-040); remove after first start
IMS_BOOTSTRAP_ADMIN_USERNAME=
IMS_BOOTSTRAP_ADMIN_PASSWORD=
IMS_BOOTSTRAP_ADMIN_FULL_NAME=
