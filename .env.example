# Copy to .env (git-ignored) and fill in. Names only: never commit values.
# Spring profile: dev | prod; a production release runs once with prod,migrate (ADR-151)
SPRING_PROFILES_ACTIVE=
# JDBC URL, e.g. jdbc:mysql://<host>:3306/<database>
IMS_DB_URL=
# Application account: SELECT/INSERT/UPDATE/DELETE, only SELECT/INSERT on stock_movements and audit_log, no DDL (ADR-087)
IMS_DB_USERNAME=
IMS_DB_PASSWORD=
# Production: host part of the application account the migrate mode grants, e.g. 127.0.0.1 (default %)
IMS_DB_APPLICATION_HOST=
# Migration account used by Flyway only: DDL, GRANT and trigger rights (ADR-087, from Phase 4).
# Production: set only for the migrate run (prod,migrate), never for the running application (ADR-151)
IMS_DB_MIGRATION_USERNAME=
IMS_DB_MIGRATION_PASSWORD=
# First Administrator, used only while the users table is empty (ADR-040); remove after first start
IMS_BOOTSTRAP_ADMIN_USERNAME=
IMS_BOOTSTRAP_ADMIN_PASSWORD=
IMS_BOOTSTRAP_ADMIN_FULL_NAME=
# Backups (ADR-144): a folder outside anything served, readable by the application user only
IMS_BACKUP_DIR=
# Read-only backup account: SELECT, SHOW VIEW, TRIGGER, LOCK TABLES on the schema and SHOW_ROUTINE (README, Backups)
IMS_BACKUP_DB_USERNAME=
IMS_BACKUP_DB_PASSWORD=
# Optional: the mysqldump program when it is not on the path
IMS_BACKUP_MYSQLDUMP=
